# ==============================================================================
# Kept / Nirgrantha - Environment Configuration
# All of these are 100% FREE. The app runs fine even if all of these are blank!
# ==============================================================================

# 1. Google Gemini API Key (100% Free Tier: 15 RPM, 1,500 RPD)
# Used for live LLM reasoning, arbitrary transcript parsing, and dynamic conflict detection.
# Get free key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Slack Incoming Webhook (100% Free)
# Used for dispatching confirmed tasks & decisions directly to your team's Slack channel.
# Create free webhook: https://api.slack.com/apps -> Create App -> Incoming Webhooks
# Or test with a free temporary endpoint from: https://webhook.site
WEBHOOK_URL=

# 3. Optional - Next.js Environment
NODE_ENV=development
